<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <setting name="callSettersOnNulls" value="true"/>
    </settings>

    <typeAliases>
        <typeAlias type="com.cucumber.market.api.common.config.CamelHashMap" alias="resultMap"></typeAlias>
        <typeAlias type="com.cucumber.market.api.dto.response.ItemDetail" alias="ItemDetail"></typeAlias>
        <typeAlias type="com.cucumber.market.api.dto.response.Item" alias="Item"></typeAlias>
        <typeAlias type="com.cucumber.market.api.dto.response.ItemSeller$Info" alias="ItemSellerInfo"></typeAlias>
        <typeAlias type="com.cucumber.market.api.dto.response.ItemSeller$Region" alias="ItemSellerRegion"></typeAlias>
    </typeAliases>

    <typeHandlers>
        <typeHandler handler="com.cucumber.market.api.common.handler.EnumUsingDbCodeTypeHandler"/>
    </typeHandlers>
</configuration>